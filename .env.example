# Copy this file to .env and fill in the keys you have.
# The service runs with any ONE of Gemini or Perplexity plus a judge.
# Nothing here is ever sent to the browser or written to the report.

# Reads PDFs, images, video and audio. Also works as the research and judge
# fallback, so a Gemini key alone is enough to run everything.
GEMINI_API_KEY=

# Judge. Decides supported / contradicted / unverified from the evidence.
# Must be a Console API key, which starts sk-ant-api03-. A sk-ant-usr- token is
# a user credential from a Claude subscription and /v1/messages rejects it.
# Leave this blank to use Gemini as the judge instead.
ANTHROPIC_API_KEY=

# Research. Searches the web per claim and returns citations.
PERPLEXITY_API_KEY=

# Optional and free. Looks up claims professional fact-checkers have already
# ruled on, via the Google Fact Check Tools API. Falls back to GOOGLE_API_KEY.
FACTCHECK_API_KEY=
GOOGLE_API_KEY=

# Override the model ids here if a provider renames one.
# GEMINI_MODEL=gemini-3.5-flash
# CLAUDE_MODEL=claude-sonnet-5-5
# PERPLEXITY_MODEL=sonar

# Leave this blank and the service is open to anyone who can reach it, which is
# right on localhost. Set it on a deployment and the page asks for it once per
# browser. Every run spends credit from the keys above, so a public URL with no
# password set spends yours, for whoever finds it.
ACCESS_PASSWORD=

# Upload ceiling in MB. Defaults to 18 locally and 3 on Vercel, where a request
# body cannot exceed 4.5 MB on any plan and base64 adds a third on the way up.
# MAX_UPLOAD_MB=

# How many claims to check per run. Each one costs a research call.
CLAIM_LIMIT=12

PORT=8788
